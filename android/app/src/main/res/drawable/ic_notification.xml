<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon, wired via AndroidInitializationSettings in
     lib/src/services/notification_service.dart.

     Must be monochrome: Android reads only the alpha channel and tints the
     result itself. @mipmap/ic_launcher has fully opaque alpha, so it rendered
     as a white square. Shape must live in transparency alone.

     Motif: the focus ring of the "eat(o)va" wordmark. Geometry mirrors
     _FocusRingPainter in lib/src/widgets/shared/eatova_wordmark.dart, scaled
     to a 22dp mark in a 24dp box (w = 22, center 12/12):
       stroke 0.105w = 2.3    ring radius 0.2575w = 5.65
       dot    0.10w  = 2.2    ticks 0.385w = 8.5 .. 0.5w = 11
     Changing the painter means changing these numbers too.

     Vector, not a PNG set: minSdk 26 resolves framework VectorDrawables in
     SystemUI's own process. A same-named bitmap in a density folder would
     shadow this file and bring the white block back; there must be none.

     No android:tint — the system colors it; our own tint would fight the
     notification accent color. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Ring -->
    <path
        android:pathData="M6.35,12 A5.65,5.65 0 1,0 17.65,12 A5.65,5.65 0 1,0 6.35,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.3" />

    <!-- Center dot -->
    <path
        android:pathData="M9.8,12 A2.2,2.2 0 1,0 14.2,12 A2.2,2.2 0 1,0 9.8,12"
        android:fillColor="#FFFFFFFF" />

    <!-- Ticks at 12/3/6/9 o'clock; butt caps like StrokeCap.butt in the painter. -->
    <path
        android:pathData="M12,3.5 L12,1 M20.5,12 L23,12 M12,20.5 L12,23 M3.5,12 L1,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.3"
        android:strokeLineCap="butt" />
</vector>
