<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme during process start, OS dark mode on. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Splash screen; removed once Flutter draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window theme once the process runs: colors the window while the
         Flutter UI initializes and behind it afterwards. V2 embedding only. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
