<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light OS mode: the app follows the device by default, so the launch
         window is light here and dark in values-night (launch_colors.xml
         holds both pairs). -->
    <!-- Window theme while the process starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Splash screen; removed once the engine draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window theme once the process has started: the color behind the
         Flutter UI while it initializes and while it runs (V2 embedding). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
