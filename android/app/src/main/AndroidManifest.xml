<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PROD-1 (flutter_local_notifications, on-device): POST_NOTIFICATIONS
         loest auf Android 13+ den Runtime-Permission-Dialog aus. Wir planen
         bewusst NUR inexakte Alarme (AndroidScheduleMode.inexactAllowWhileIdle),
         daher KEIN SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM noetig — das vermeidet
         die Play-Policy-Sonderpruefung und die Spezial-Berechtigung.
         RECEIVE_BOOT_COMPLETED laesst geplante Nudges einen Geraete-Neustart
         ueberleben. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- E1: camera_android_camerax deklariert RECORD_AUDIO und
         WRITE_EXTERNAL_STORAGE (maxSdkVersion=28) fuer die Video-Aufnahme.
         Aus WRITE_EXTERNAL_STORAGE leitet der Manifest-Merger zusaetzlich ein
         READ_EXTERNAL_STORAGE OHNE maxSdkVersion ab — auf API 29-32 also eine
         echte Laufzeitberechtigung.

         Eatova nimmt ausschliesslich Standbilder auf (CameraController ohne
         enableAudio-Video-Pfad) und laedt Galeriebilder ueber image_picker.
         image_picker_android nutzt den System-Photo-Picker bzw.
         ACTION_GET_CONTENT und braucht deshalb KEINE Storage-Berechtigung
         (ImagePickerDelegate prueft nur Manifest.permission.CAMERA;
         image_picker README: "no longer required to add
         requestLegacyExternalStorage, scoped storage").

         Sprache im Coach laeuft ueber den MethodChannel `eatova/speech`, der
         NUR in ios/Runner/AppDelegate.swift registriert ist. Auf Android
         wirft invokeMethod eine MissingPluginException, die
         CoachSpeechInput.listen in eine "nicht verfuegbar"-Meldung uebersetzt.
         Es gibt keinen Android-Sprachpfad, also auch keinen RECORD_AUDIO-
         Bedarf. Die Berechtigung wuerde im Play-Store nur "Mikrofon"
         ausweisen. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:label="Eatova"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:dataExtractionRules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="eatova"
                    android:host="login-callback" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- D1: flutter_local_notifications liefert KEINE Komponenten mit.
             Sein Plugin-Manifest
             (flutter_local_notifications-22.2.0/android/src/main/AndroidManifest.xml)
             enthaelt nur zwei uses-permission-Eintraege und null Receiver —
             jede Komponente muss die App selbst deklarieren.

             ScheduledNotificationReceiver ist das Ziel JEDES geplanten
             Alarms (FlutterLocalNotificationsPlugin.java:590/613/639/721 und
             1852/1875/1897). Ohne diese Zeile verwirft Android den Broadcast
             still: kein Crash, keine Benachrichtigung, nie. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- flutter_local_notifications: Receiver, der nach einem Geraete-
             Neustart (BOOT_COMPLETED) die geplanten lokalen Nudges erneut
             einplant (FlutterLocalNotificationsPlugin.rescheduleNotifications).
             Braucht den expliziten Intent-Filter, um zu triggern. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Bewusst NICHT deklariert, weil die App sie nicht ansteuert:
             * ActionBroadcastReceiver — nur noetig fuer Notification-Actions
               (NotificationDetails.actions) oder dismissIsolate
               (FlutterLocalNotificationsPlugin.java:303/333). NotificationService
               _details() setzt beides nicht.
             * ForegroundService — nur noetig fuer startForegroundService
               (FlutterLocalNotificationsPlugin.java:2342/2364). Wird nicht
               aufgerufen.
             Wer eines der beiden Features nachruestet, MUSS die zugehoerige
             Komponente hier ergaenzen — sonst schlaegt es genauso still fehl
             wie D1. -->

        <!-- E4: package:health zieht androidx.health.connect:connect-client
             (1.2.0-alpha02) in den Android-Build und injiziert diesen Dienst
             mit android:exported="true" OHNE android:permission — die einzige
             ungeschuetzt exportierte Komponente der App ausser der
             Launcher-Activity.

             Health Connect ist auf Android unerreichbar: jede Methode in
             lib/src/services/apple_health_service.dart steigt mit
             `if (!Platform.isIOS) return` aus. Der Dienst hat also keinen
             Aufrufer und wird entfernt.

             Sauberere Alternative (nicht hier machbar, liegt in pubspec.yaml):
             `health` per dependency_overrides/Plattform-Split ganz aus dem
             Android-Build nehmen. Das wuerde auch compose-bom, fragment-ktx
             und libdartjni.so sparen — und MainActivity koennte wieder von
             FlutterActivity statt FlutterFragmentActivity erben. -->
        <service
            android:name="androidx.health.platform.client.impl.sdkservice.HealthDataSdkService"
            tools:node="remove" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
