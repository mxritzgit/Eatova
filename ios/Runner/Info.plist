	<key>NSHealthUpdateUsageDescription</key>
	<string>Eatova schreibt optional dein eingetragenes Gewicht nach Apple Health zurück.</string>
	<!-- PROD-1 (flutter_local_notifications, on-device): Lokale Notifications
