/* English usage descriptions (F10-01). Identical to the Info.plist values,
   which are the fallback for every other language; kept here so Xcode lists
   English as a real localization next to German. Health texts cover exactly
   the scopes apple_health_service.dart requests: steps + weight read, weight
   write — no sleep. */

"NSCameraUsageDescription" = "Eatova needs camera access so you can photograph meals, scan product barcodes, send your coach a picture and add a photo to your own recipes. Meal photos are analysed for nutrition values; recipe photos stay on your iPhone.";
"NSMicrophoneUsageDescription" = "Eatova needs microphone access so you can dictate a question to your coach or describe a meal instead of typing. Audio is captured only while voice input in the coach chat or the meal description is active.";
"NSSpeechRecognitionUsageDescription" = "Eatova turns your dictated coach question or meal description into text. If your iPhone has the speech model for your language on device, the audio stays on the device; otherwise Apple processes it on its servers.";
"NSPhotoLibraryUsageDescription" = "Eatova needs access to your photo library so you can pick an existing photo of a meal or a coach picture from the gallery for analysis, or a photo for one of your own recipes.";
"NSHealthShareUsageDescription" = "Eatova reads your step count from Apple Health and credits it to your daily budget. Once you allow the scale import, new weights from your scale are added to your weight history.";
"NSHealthUpdateUsageDescription" = "Eatova optionally writes a weight you log back to Apple Health and corrects it there when you edit or delete that weigh-in.";
